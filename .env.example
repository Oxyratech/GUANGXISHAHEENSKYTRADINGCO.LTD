# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for development. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public origin of the site, no trailing slash. Leave unset until a domain is owned; while unset the
# site is served with noindex. Example (placeholder only): https://www.example.com
NEXT_PUBLIC_SITE_URL=

# SQL Server / Azure SQL connection string (Prisma format). Needed for inquiries, contact messages,
# products, news and the admin area. The public content pages render without it.
# Azure SQL example:
#   sqlserver://<server>.database.windows.net:1433;database=<db>;user=<user>;password=<password>;encrypt=true
DATABASE_URL=

# Secret used to hash IP addresses and sign short-lived tokens. 32+ random bytes, generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Optional: SMTP for new-inquiry notification emails. If unset, no email is sent (nothing is faked).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
INQUIRY_NOTIFY_EMAIL=

# Uploads are stored in the database (see docs/ARCHITECTURE.md). Limit in bytes for inquiry attachments
# and images; capped at 7 MiB (the Server Action body limit is 8 MB).
UPLOAD_MAX_BYTES=5242880

# Optional: debug | info | warn | error | silent (default: info).
LOG_LEVEL=

# Optional: privacy-friendly analytics (Plausible). If unset, no analytics script is loaded.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional: initial Super Admin created by `npm run db:seed`. Both must be set; password >= 12 chars.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Public contact channels. NONE have been supplied yet, so the site shows none until you set them here
# or in Admin → Settings (admin values override these). Never invented, never defaulted.
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_WHATSAPP=

# CI/automation only: password read by `npm run admin:create` instead of prompting. Never commit it.
ADMIN_PASSWORD=
